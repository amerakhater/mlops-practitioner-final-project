# Copy to .env and edit. .env is gitignored; this file is the committed template.
#
# Every setting is optional -- the defaults below are what the service uses if
# the variable is absent. All of them are read with the PRODLLM_ prefix by
# prodllm.config.Settings.
#
# NEVER put secrets in here or in .env. The Docker Hub personal access token
# lives in the Windows Credential Manager (written by `docker login`), not in a
# file in the repository.

# --- Model artifacts ------------------------------------------------------
# Where the weights and metadata live. Deliberately RELATIVE by default: an
# absolute default is the "works on my laptop, fails in the container" trap.
# The image overrides this with PRODLLM_ARTIFACTS_DIR=/app/artifacts.
PRODLLM_ARTIFACTS_DIR=artifacts

# Subdirectory of ARTIFACTS_DIR holding config.json, the tokenizer and the
# weights, as written by scripts/fetch_weights.py.
PRODLLM_WEIGHTS_DIRNAME=model

# Subdirectory of ARTIFACTS_DIR holding the FAISS index and its metadata
# sidecar, as written by scripts/build_index.py.
PRODLLM_INDEX_DIRNAME=index

# Provenance file: source model id, revision, dim, serialization format, sha256.
PRODLLM_METADATA_FILE=metadata.json

# The encoder. Changing it invalidates the index: rebuild with
# scripts/build_index.py, or retrieval silently compares vectors from two
# different embedding spaces.
PRODLLM_SOURCE_MODEL_ID=intfloat/multilingual-e5-small

# Fetch the weights from Hugging Face when WEIGHTS_DIRNAME is absent. The
# default image bakes them in and sets this to false, so a misconfigured
# artifacts path fails loudly at startup instead of silently downloading.
PRODLLM_ALLOW_DOWNLOAD=true

# --- Inference ------------------------------------------------------------
# Tokens per input before truncation. The model's own limit is 512; raising
# this past that overruns its position embeddings.
PRODLLM_MAX_SEQ_LENGTH=512

# torch intra-op threads. 1 keeps per-container memory and latency predictable;
# scale by running more replicas rather than more threads per replica.
PRODLLM_TORCH_NUM_THREADS=1

# --- Request limits (published on /metadata so clients need not guess) ----
PRODLLM_MAX_BATCH_SIZE=64
PRODLLM_MAX_TEXT_CHARS=8000
PRODLLM_MAX_QUESTION_CHARS=2000

# --- Retrieval ------------------------------------------------------------
# Article chunks, read by scripts/build_index.py only. The service loads the
# built index, never the JSON, and never embeds the corpus at startup.
PRODLLM_CORPUS_CHUNKS_PATH=data/processed/chunks.json

# Articles cited per answer.
PRODLLM_TOP_K=5

# Cosine floor, 0.0 = disabled. That default is a measured result, not an
# oversight: on this corpus the on-topic (0.838-0.899) and off-topic
# (0.789-0.859) score ranges overlap, so no absolute threshold separates them.
# See the measurements in prodllm.rag.DEFAULT_MIN_SCORE.
PRODLLM_MIN_SCORE=0.0

# --- Generation -----------------------------------------------------------
# Leave LLM_BASE_URL and LLM_MODEL empty to use the extractive generator,
# which quotes the retrieved articles verbatim and so cannot hallucinate.
# Setting both switches to an OpenAI-compatible chat completions endpoint.
#
# The service ships with these empty. The *evaluation harness* needs them set:
# RAGAS faithfulness over extractive answers is ~1.0 by construction, because
# the answer is a verbatim copy of its contexts, so a sweep run that way
# compares six configurations that all score a perfect 1.0. OpenRouter is an
# OpenAI-compatible endpoint and is what this project uses:
#
#   PRODLLM_LLM_BASE_URL=https://openrouter.ai/api/v1
#   PRODLLM_LLM_MODEL=openai/gpt-4o-mini
PRODLLM_LLM_BASE_URL=
PRODLLM_LLM_MODEL=
PRODLLM_LLM_TIMEOUT_SECONDS=30
# PRODLLM_LLM_API_KEY is a secret. Pass it at run time
# (`docker run -e PRODLLM_LLM_API_KEY=...`) and never commit a value here.

# --- Evaluation and tracking (Module 2) -----------------------------------
# The RAGAS judge. It falls back to PRODLLM_LLM_API_KEY, so with the generator
# configured above there is nothing more to set; PRODLLM_JUDGE_API_KEY exists
# so the judge can be billed to a different account than the generator.
# Also a secret -- in CI it is the OPENROUTER_API_KEY repository secret.
# PRODLLM_JUDGE_API_KEY=

# The MLflow tracking server the sweep logs to. Start it with either
#   docker compose --profile tracking up -d mlflow
#   uv run --group tracking python scripts/mlflow_server.py
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- Operations -----------------------------------------------------------
# DEBUG additionally emits a per-call latency line from the @log_latency
# decorator. INFO covers lifecycle and one line per request.
PRODLLM_LOG_LEVEL=INFO

# Load the model during startup rather than on first request. Keep this true:
# loading inside the request handler costs roughly 100x per-request latency.
PRODLLM_EAGER_LOAD=true
