# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local environment overrides (commit .env.example instead)
.env

# Model weights and the FAISS index. Regenerated by scripts/build_index.py
# (weights are downloaded from the Hub on first run) -- never committed.
# The directory rule keeps the whole tree out; the extension globs below stop a
# stray 450 MB weight file landing anywhere else in the repo.
artifacts/
models/

# Data is versioned with DVC, not git: the payload stays out, the .dvc pointer
# files and DVC's own generated .gitignore files are committed. A blanket
# `data/` rule would swallow those pointers and defeat the whole mechanism.
/data/**
!/data/**/
!/data/**/*.dvc
!/data/**/.gitignore
/data/raw/*.pdf
.dvc/cache/
.dvc/tmp/
.dvc/config.local
*.safetensors
*.bin
*.pt
*.pth

# Caches redirected off the C: drive (see README: disk layout)
.caches/

# Test and lint caches / coverage output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Logs
*.log

# NOTE: reports/ is deliberately NOT ignored -- reports/module-1.md is a deliverable.
